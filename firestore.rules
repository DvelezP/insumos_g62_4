rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Solicitudes de insumos: acceso temporal mientras se implementa
    // Firebase Authentication. Caduca el 15 de diciembre de 2026.
    match /solicitudes/{solicitudId} {
      allow read, write: if request.time < timestamp.date(2026, 12, 15);
    }

    // Todo lo demás queda denegado.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
